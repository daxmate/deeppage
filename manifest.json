{
    "action": {
        "default_icon": {
            "128": "icons/icon128.png",
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "64": "icons/icon64.png"
        },
        "default_title": "DeepPage"
    },
    "author": "daxmate",
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "exclude_matches": [
                "https://chat.deepseek.com/*"
            ],
            "js": [
                "marked.umd.min.js",
                "content.js"
            ],
            "matches": [
                "<all_urls>"
            ],
            "run_at": "document_end"
        }
    ],
    "description": "在浏览网页时与 DeepSeek 对话——总结全文、提炼要点、自由问答",
    "host_permissions": [
        "https://api.deepseek.com/*"
    ],
    "icons": {
        "128": "icons/icon128.png",
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "64": "icons/icon64.png"
    },
    "manifest_version": 3,
    "name": "DeepPage",
    "options_page": "options.html",
    "permissions": [
        "storage",
        "tabs",
        "windows"
    ],
    "version": "0.2.0"
}
