{
    "action": {
        "default_icon": {
            "128": "icons/icon128.png",
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "64": "icons/icon64.png"
        },
        "default_title": "DeepPage"
    },
    "author": "daxmate",
    "background": {
        "service_worker": "js/background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "exclude_matches": [
                "https://chat.deepseek.com/*"
            ],
            "js": [
                "js/marked.umd.min.js",
                "js/i18n.js",
                "js/utils.js",
                "js/chat.js",
                "js/sidebar.js",
                "js/content.js"
            ],
            "matches": [
                "<all_urls>"
            ],
            "run_at": "document_end"
        }
    ],
    "description": "Chat with DeepSeek while browsing \u2014 summarize, outline, translate, and ask questions",
    "name": "DeepPage",
    "host_permissions": [
        "https://api.deepseek.com/*"
    ],
    "icons": {
        "128": "icons/icon128.png",
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "64": "icons/icon64.png"
    },
    "manifest_version": 3,
    "options_page": "options.html",
    "permissions": [
        "storage",
        "tabs",
        "windows"
    ],
    "version": "1.7.5"
}
